pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "snehily211/devops_test"
        DOCKER_CREDENTIALS_ID = 'dockerhubcredential'
        // Deployment details
        DEPLOYMENT_NAME = 'ml-serving-deployment'
        CONTAINER_NAME = 'ml-serving-container' // k8s/deployment.yaml ke container ka name
    }

    stages {
        stage('Code Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint & Unit Testing') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install -r requirements.txt
                    pytest -v
                '''
            }
        }

        stage('Build & Tag Docker Image') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest ."
            }
        }

        stage('Push Image to Registry') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDENTIALS_ID}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                        docker push ${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }

        stage('Deploy to Docker Desktop K8s') {
            steps {
                sh """
                    # Docker Desktop context select karein
                    kubectl config use-context docker-desktop || true
                    
                    # Manifest apply karein
                    kubectl apply -f k8s/deployment.yaml
                    
                    # New build tag update karein
                    kubectl set image deployment/${DEPLOYMENT_NAME} ${CONTAINER_NAME}=${DOCKER_IMAGE}:${BUILD_NUMBER}
                    
                    # Rollout status check karein
                    kubectl rollout status deployment/${DEPLOYMENT_NAME} --timeout=120s
                """
            }
        }
    }

    post {
        always {
            sh "docker logout || true"
            cleanWs()
        }
    }
}